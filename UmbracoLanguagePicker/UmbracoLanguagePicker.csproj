<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ContentTargetFolders>.</ContentTargetFolders>
    <Product>UmbracoLanguagePicker</Product>
    <PackageId>UmbracoLanguagePicker</PackageId>
    <Title>UmbracoLanguagePicker</Title>
    <Description>An Umbraco 17 property editor for picking one of the site's configured languages, with an optional unique-per-sibling filter.</Description>
    <PackageTags>umbraco plugin package</PackageTags>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.7.0" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.7.0" />
	  <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only ship the built client files, not src/ or node_modules/ -->
    <Content Include="App_Plugins\LanguagePicker\dist\**;App_Plugins\LanguagePicker\Localization\**;App_Plugins\LanguagePicker\umbraco-package.json">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Include="build\**">
      <Pack>true</Pack>
      <PackagePath>buildTransitive</PackagePath>
    </None>
  </ItemGroup>
</Project>
